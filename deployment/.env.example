# Copy to deployment/.env and fill in — never commit the real .env file.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Optional — required only for enable_diarization
HF_TOKEN=

# Optional — leave blank to disable Sentry
SENTRY_DSN=

# Optional — override the default dev password for the postgres container
POSTGRES_PASSWORD=scaitale_dev_password
