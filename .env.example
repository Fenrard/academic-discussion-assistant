# Scaitale backend — environment variable template.
#
# Copy this file to `.env` at the repo root (scripts/setup_backend.ps1 does this for you
# automatically, generating a fresh JWT_SECRET_KEY, the one time .env doesn't exist yet —
# it will never overwrite an existing .env). Nothing in backend/core/config.py reads dotenv
# files automatically (there is no python-dotenv dependency in this project — see
# docs/ARCHITECTURE_DECISIONS.md) — `.env` here is a convenience file for you to load into
# your shell yourself, e.g. via a small wrapper, or by setting these as real PowerShell
# `$env:` variables directly. `os.environ.get(...)` in backend/core/config.py is the actual
# source of truth for every value below.
#
# Every variable below is read in exactly one place: backend/core/config.py's `Settings`
# class, except JWT_SECRET_KEY (backend/core/security.py) and ENVIRONMENT's production-mode
# check (backend/main.py's `lifespan()`). Nothing here is required for `pytest tests/ -v` to
# pass — the test suite's own fixtures (tests/conftest.py) set what they need.
#
# NEVER commit a real, filled-in `.env` file — it's already in .gitignore. This file
# (.env.example) contains no real secrets, only safe defaults and blank placeholders.

# --- Auth (REQUIRED to start the API at all) ---
# Signs/verifies every JWT this app issues. Any value works for local dev. Generate a real
# one with: python -c "import secrets; print(secrets.token_hex(32))"
# In ENVIRONMENT=production, backend/main.py refuses to start if this is unset.
JWT_SECRET_KEY=

# --- Environment mode ---
# "development" (default) — permissive local behavior. "production" — backend/main.py fails
# loudly at startup instead of running insecurely (e.g. with no JWT_SECRET_KEY).
ENVIRONMENT=development

# --- Database ---
# Unset -> SQLite at backend/database/scaitale.db (zero setup, the default for local dev and
# for `pytest`). Set to a real Postgres URL for the "production architecture" path, e.g.:
# DATABASE_URL=postgresql+psycopg://scaitale:scaitale_dev_password@localhost:5432/scaitale
DATABASE_URL=

# --- Hugging Face (only needed for optional pyannote diarization) ---
# Leave blank to run with enable_diarization always unavailable (the worker logs a warning
# at startup and that one toggle simply can't be used — nothing else breaks). To use it:
# create a token at huggingface.co, accept pyannote/speaker-diarization-community-1's terms
# with that account, then paste the token here.
HF_TOKEN=

# --- Whisper (ASR) ---
# Any faster-whisper-supported size string or HF repo ID. "small" is what this project has
# actually been run against and measured (see docs/ML_PIPELINE.md).
WHISPER_MODEL_SIZE=small
# "cpu" or "cuda" — see docs/MODIFICATION_COOKBOOK.md entry 24 before changing this; the
# torch build installed by requirements.txt/requirements-worker.txt by default is CPU-only,
# so setting this to "cuda" without also reinstalling a CUDA-enabled torch wheel will fail
# to load the model, not silently fall back.
WHISPER_DEVICE=cpu
# "int8" is the CPU-appropriate choice this project uses; "float16" is the typical GPU choice.
WHISPER_COMPUTE_TYPE=int8
# 0 = let CTranslate2 pick. Set to your machine's physical core count ONLY when running a
# single worker process (--concurrency=1); leave 0 under a multi-worker pool.
WHISPER_CPU_THREADS=0

# --- Teacher verification (SpeechBrain ECAPA-TDNN) ---
# Cosine-similarity cutoff for "is this segment the enrolled teacher". Documented, unvalidated
# heuristic default — see docs/MODIFICATION_COOKBOOK.md entry 18 before tuning this for real.
TEACHER_VERIFICATION_THRESHOLD=0.35

# --- Celery / Redis (async inference tier) ---
# All three blank -> Celery's eager mode: tasks run inline in the API process, no broker
# needed at all. This is the zero-infra default for local dev, tests, and CI.
# Set CELERY_BROKER_URL (and usually CELERY_RESULT_BACKEND to the same value) to run a real,
# separate `celery -A backend.worker.celery_app worker` process. Use 127.0.0.1, NOT
# "localhost" — see CLAUDE.md's Development Environment notes on why (IPv6 dual-stack stall).
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Only used directly by backend/core/pubsub.py; defaults to CELERY_BROKER_URL if that's set,
# else redis://127.0.0.1:6379/0. Usually left unset — set CELERY_BROKER_URL instead.
REDIS_URL=

# --- Rate limiting / upload limits ---
MAX_UPLOAD_BYTES=209715200
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_TRANSCRIBE=30/minute
RATE_LIMIT_ENROLL=10/minute

# --- Observability ---
# Leave blank to disable Sentry entirely (the default — Sentry is a no-op unless this is set).
SENTRY_DSN=
LOG_LEVEL=INFO
